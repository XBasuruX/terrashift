    "/api/v1/{product}/subsetOrder": {
      "get": {
        "description": "On success, this returns an order ID and an email with a link to the subset order will be dispatched to the provided email address.",
        "operationId": "get_subset_order",
        "parameters": [
          {
            "description": "Short name of the product to query.",
            "in": "path",
            "name": "product",
            "required": true,
            "type": "string"
          },
          {
            "description": "Latitude in geographic Lat/Long WGS 84 coordinate system.",
            "format": "float",
            "in": "query",
            "name": "latitude",
            "required": true,
            "type": "number"
          },
          {
            "description": "Longitude in geographic Lat/Long WGS 84 coordinate system.",
            "format": "float",
            "in": "query",
            "name": "longitude",
            "required": true,
            "type": "number"
          },
          {
            "description": "Email address to which this order will be sent.",
            "format": "email",
            "in": "query",
            "name": "email",
            "required": true,
            "type": "string"
          },
          {
            "description": "Unique tag for the order.",
            "in": "query",
            "maxLength": 8,
            "name": "uid",
            "required": true,
            "type": "string"
          },
          {
            "description": "Composite start date (AYYYYDDD) of the subset period.",
            "in": "query",
            "name": "startDate",
            "required": true,
            "type": "string"
          },
          {
            "description": "Composite end date (AYYYYDDD) of the subset period.",
            "in": "query",
            "name": "endDate",
            "required": true,
            "type": "string"
          },
          {
            "description": "Size in km of the subset above and below the center location.",
            "format": "int32",
            "in": "query",
            "name": "kmAboveBelow",
            "required": true,
            "type": "integer"
          },
          {
            "description": "Size in km of the subset left and right of the center location.",
            "format": "int32",
            "in": "query",
            "name": "kmLeftRight",
            "required": true,
            "type": "integer"
          },
          {
            "description": "Projection type of the generated GeoTIFF coordinates.<br>Available projections: <br>&emsp;SIN ... MODIS Sinusoidal Projection<br>&emsp;GEOG ... Geographic Lat/long.<br>Default: SIN",
            "in": "query",
            "name": "projection",
            "required": false,
            "type": "string"
          }
        ],
        "produces": [
          "application/json",
          "text/csv"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "No data available for time period {startDate} to {endDate} for {product} {latitude} {longitude} combination"
          },
          "404": {
            "description": "Product not found"
          }
        },
        "summary": "Order subset and detailed projection information for the location, product and date combination.",
        "tags": [
          "subsetOrder"
        ],
        "x-swagger-router-controller": "frontend.rest_frontend.controllers.subset_order_controller"
      }
    },
